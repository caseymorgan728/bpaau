{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bpaau",
  "main": "_worker.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
