{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bpaau",
  "main": "_worker.js",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Serve blog/index.html at /blog with no trailing slash. Must stay
    // "drop-trailing-slash" so ASSETS never 301s /blog -> /blog/, which the
    // worker's trailing-slash normaliser would bounce straight back (loop).
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true
  }
}
